# Copie ce fichier en .env et ne le publie JAMAIS (ajoute .env à .gitignore).
# Clé restreinte (rk_test_...) recommandée, avec les droits : Products, Prices, Customers,
# Checkout Sessions, Customer portal sessions, Subscriptions (lecture), Billing portal configurations.
STRIPE_SECRET_KEY=rk_test_xxx
# Fourni par `stripe listen` en local, ou par l'endpoint webhook du Dashboard en ligne.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# URL publique du site Vitako (sans slash final) : redirections Checkout et CORS.
SITE_URL=http://localhost:8080
PORT=4242
